{
  "name": "krino",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.13.1",
  "bin": {
    "krino": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "krino": "node dist/cli.js",
    "api": "pnpm build && node dist/server/main.js",
    "db:generate": "drizzle-kit generate",
    "fixture": "pnpm build && node dist/fixture/server.js",
    "run:success": "pnpm build && node dist/cli.js run examples/login.json",
    "run:failure": "pnpm build && node dist/cli.js run examples/login-failing.json"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "playwright": "^1.55.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.18.6",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.2"
  }
}
